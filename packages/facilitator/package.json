{
  "name": "@agentsmith/stellar-facilitator",
  "version": "0.1.3",
  "private": true,
  "description": "Standalone x402 v2 facilitator for Stellar exact and experimental upto payments.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "testnet:create-account": "tsx scripts/create-testnet-account.ts",
    "kms:provision": "tsx scripts/provision-kms-signer.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:pubnet": "vitest run --config vitest.pubnet.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1141.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@stellar/stellar-sdk": "16.3.1",
    "@x402/core": "2.28.0",
    "@x402/stellar": "2.28.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "kysely-pglite-dialect": "1.3.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.4"
  }
}
