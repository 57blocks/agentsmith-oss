# Local testnet setup. Every variable is described in README.md#configuration.

DATABASE_URL=postgres://facilitator:facilitator@127.0.0.1:5432/facilitator
CHANNEL_STORE_URL=redis://127.0.0.1:6379/0

# Local development and debugging only: plain fee-payer and channel seeds, printed by
# `pnpm testnet:create-account`. Production signs with KMS instead (below) and refuses these.
FACILITATOR_STELLAR_FEE_BUMP_SECRET=
FACILITATOR_STELLAR_CHANNEL_SECRETS=
# Set by `pnpm testnet:create-account` alongside the fee-payer and channel seeds above.
FACILITATOR_STELLAR_PRIVATE_KEY=

# STELLAR_NETWORK=stellar:testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Production: KMS signing is required, and the seeds above must be removed. Only key
# addresses are configured; the private keys stay in KMS.
# NODE_ENV=production
# FACILITATOR_SIGNING_MODE=kms
# FACILITATOR_KMS_REGION=us-west-1
# FACILITATOR_KMS_FEE_PAYER_ADDRESS=G_FEE_PAYER
# FACILITATOR_KMS_CHANNEL_ADDRESSES=G_CHANNEL_1,G_CHANNEL_2

# upto: the Kernel contract, plus the key Buyers authorize (env mode: seed; KMS mode: address).
# The default is the testnet Kernel; on pubnet use CCV4RALFBEE2QLKPK6H5ZX24CYMKIFN3723J5J4TMDEFWAFLELGYODNI.
# Both are built and deployed from https://github.com/57blocks/agentsmith-contracts.
X402_UPTO_KERNEL_CONTRACT=CBB7WCIQOBOJ4G7JUPVOA3RI553HBSYQ3GLBJ25X7W7S7MRJIGVCXRE3

# FACILITATOR_KMS_AUTHORIZATION_ADDRESS=G_UPTO_AUTH

# Admin name -> key (32+ characters) for the /admin routes; unset disables them.
# ADMIN_API_KEYS={"alice":"replace-with-a-long-random-admin-key"}

# HMAC key (32+ characters) so registration stays rate-limited while the channel store is down.
# REGISTRATION_IP_HASH_KEY=replace-with-a-long-random-key

# End-to-end tests (`pnpm test:e2e`) call a running facilitator on stellar:testnet over HTTP and pay
# with friendbot-funded accounts. Defaults to the local service started above.
E2E_FACILITATOR_URL=http://127.0.0.1:8407
# The pool test fills every channel, so this must equal the target's channel count (one by default).
# E2E_CHANNEL_COUNT=1
