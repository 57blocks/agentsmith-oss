# Copy this file to .env.integration; integration tests load it automatically.
# `pnpm testnet:create-accounts` creates and funds a Seller and a Buyer and prints the two lines below.
# Required Seller recipient. X402_PAY_TO from an existing weather .env is also accepted.
SELLER_ADDRESS=

# Required only for paid journeys: a testnet account holding USDC.
# WEATHER_BUYER_SECRET from agentsmith is also accepted.
BUYER_SECRET=

# The Seller's Facilitator API key. Optional on testnet (anonymous Sellers are accepted), but this
# journey requires it to exercise the complete authenticated case, sent on every facilitator call.
# Obtain one with ApiKeyManager / the API key journey and paste it here.
SELLER_API_KEY=

